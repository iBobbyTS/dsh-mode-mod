{
  "name": "@local/dsh-mode-mod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "System-prompt-preset (development-goal) dimension layered on any mode, with three-tier defaults, host-injected run_code guidance, and the Creator-mode source context.",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./guidance": "./lib/guidance.js",
    "./web-research": "./lib/web-research.js",
    "./client": "./lib/client.js",
    "./prompts/*": "./prompts/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "prompts",
    "presets",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/creator-cordis.patch.yml",
        "./presets/web-research.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-alpha.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "node scripts/check.mjs test",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all"
  }
}
